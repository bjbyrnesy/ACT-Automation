# ---------------------------------------------------------------------------
# Secrets & local credentials (never commit)
# ---------------------------------------------------------------------------
# ACT/CVaaS cached config (ACT_API_KEY, CVAAS_TOKEN, …)
.config
.config.*
!.config.example

.env
.env.*
!.env.example

# Common key / cert material
*.pem
*.key
*.p12
*.pfx
*.jks
*.keystore
id_rsa
id_rsa.*
id_ed25519
id_ed25519.*
id_ecdsa
id_ecdsa.*
*.pub.bak

# Credential dumps / secret stores
.secrets/
secrets/
secrets.*
**/credentials.json
**/credentials.*.json
**/service-account*.json
**/*-service-account.json
**/cvaas*token*
**/act*api*key*

# ---------------------------------------------------------------------------
# Generated topology / lab artifacts (keep GitHub Actions YAML trackable)
# ---------------------------------------------------------------------------
# Local Web UI / CLI working labs (never commit real topologies here).
labs/**
!labs/.gitkeep

topology*
!acta/topology*.py
!tests/test_topology*.py

*.yml
!.github/
!.github/**/*.yml
!.forgejo/
!.forgejo/**/*.yml
!.env.example
!.config.example
# Tracked sample topologies for docs / smoke (copy into labs/ to use).
!examples/
!examples/**/*.yml


*.yaml
!.github/**/*.yaml
!.pre-commit-config.yaml

*.annotations.json
*.eos
*.png
!docs/**/*.png

# containerlab / support-bundle outputs
*.tar
*.tar.gz
*.tgz
*.zip
support-bundle*
clab-*/
.act-automation/

# ---------------------------------------------------------------------------
# Local scratch (agents, research, parallel-buckets)
# ---------------------------------------------------------------------------
# Allow shared project MCP; keep other .cursor/* local
.cursor/*
!.cursor/mcp.json
docs/research/
parallel-buckets.local.yaml
*.local.yaml
*.local.yml
tmp_*
.tmp/

